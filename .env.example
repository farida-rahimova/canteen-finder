# Copy this file to ".env" and change the passwords.
# ".env" is in .gitignore and is never committed.

# PostGIS (owner of the database – used by the scraper)
POSTGRES_DB=canteenfinder
POSTGRES_USER=canteen_admin
POSTGRES_PASSWORD=change-me-admin

# Read-only database user for GeoServer
GEOSERVER_DB_USER=geoserver_reader
GEOSERVER_DB_PASSWORD=change-me-reader

# GeoServer web admin (http://localhost:8080/geoserver)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me-geoserver
